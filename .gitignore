# Environnements
.venv/
.venv-broken-*/
.matplotlib/
.ultralytics/
__pycache__/
*.pyc
.Python

# Poids YOLO de base / caches locaux
yolo11*.pt
weights/
Ultralytics/
runs/

# Données lourdes (ne pas pousser)
training/dataset/detector/
training/dataset/levels/
training/dataset/level-splits.jsonl
training/classification/
training/imports/
training/sources/find-this-base-v1-yolov11/
training/sources/*/
!training/sources/*.json
!training/sources/*.md
training/inbox/screenshots/*
!training/inbox/screenshots/README.md
# Collecte privée élargie — JAMAIS pousser les images / exports JSON amis
# Sessions / provenance JSON OK (annotation locale) ; binaires exclus.
training/inbox/private/**
!training/inbox/private/
!training/inbox/private/**/
!training/inbox/private/README.md
!training/inbox/private/**/.gitkeep
!training/inbox/private/**/*.session.json
!training/inbox/private/**/*.provenance.json
!training/inbox/private/reference-only/wall-fandom/index.json
training/inbox/private/**/*.jpg
training/inbox/private/**/*.jpeg
training/inbox/private/**/*.png
training/inbox/private/**/*.webp
training/inbox/private/exports-json/**
!training/inbox/private/exports-json/.gitkeep
# Binaires inbox publique (recréables via stage_priority_visual_candidates.py)
training/inbox/public-reference/**/*.jpg
training/inbox/public-reference/**/*.jpeg
training/inbox/public-reference/**/*.png
training/inbox/public-reference/**/*.webp
# Seeds Guardian : petits, trackés sous reference-only/
training/runs/
training/logs/*.log
training/exports/
training/curation/
training/reports/*.txt
training/reports/*.md
!training/reports/.gitkeep

# Modèles binaires lourds (releases via GitHub Releases si besoin)
models/**/*.pt
models/**/*.onnx
!models/.gitkeep
!models/README.md
!models/ACTIVE.json
!models/experimental/README.md
!models/releases/**/release.json

